  "trees": [
    {
      "tree_id": "tree-power",
      "title": "Bike has no power / appears dead",
      "scope": "error_code",
      "version": 2,
      "is_active": true,
      "max_steps": 8,
      "entry_step_id": "ds-power-1",
      "translations": {
        "ur": {
          "title": "بائیک میں پاور نہیں ہے / بالکل بند لگ رہی ہے"
        }
      },
      "steps": [
        {
          "step_id": "ds-power-2b",
          "step_type": "question",
          "instruction": "With the battery removed, sniff near the controller box (usually located under the downtube or near the motor area).",
          "question": "Do you notice a burnt or electrical smell coming from the controller area?",
          "expected_response": "yes_no",
          "media_ref": null,
          "safety_class": null,
          "translations": {
            "ur": {
              "instruction": "بیٹری نکالنے کے بعد، کنٹرولر باکس کے قریب سونگھیں (یہ عام طور پر ڈاؤن ٹیوب کے نیچے یا موٹر کے قریب ہوتا ہے)۔",
              "question": "کیا آپ کو کنٹرولر کے حصے سے جلنے کی یا الیکٹریکل بو آ رہی ہے؟"
            }
          },
          "is_terminal": true,
          "branches": [],
          "concludes": {
            "cause_id": "cause-controller-mosfet-failure",
            "description": "MOSFET failure in controller due to moisture ingress",
            "safety_class": "caution",
            "translations": {
              "ur": {
                "description": "نمی داخل ہونے کی وجہ سے کنٹرولر میں MOSFET کی خرابی"
              }
            },
            "fixes": [
              {
                "fix_id": "fix-replace-motor-controller",
                "description": "Replace motor controller unit (dealer-only repair)",
                "difficulty": "hard",
                "requires_technician": true,
                "est_minutes": 120,
                "warranty_status": null,
                "rank": 1,
                "translations": {
                  "ur": {
                    "description": "موٹر کنٹرولر یونٹ تبدیل کریں (صرف ڈیلر کے ذریعے مرمت)"
                  }
                }
              }
            ]
          }
        },
        {
          "step_id": "ds-power-2a",
          "step_type": "question",
          "instruction": "Remove the battery from the frame and inspect the connector pins on both the battery and the frame mount.",
          "question": "Do you see green corrosion, bent pins, or debris on the connector?",
          "expected_response": "yes_no",
          "media_ref": null,
          "safety_class": null,
          "translations": {
            "ur": {
              "instruction": "فریم سے بیٹری نکالیں اور بیٹری اور فریم ماؤنٹ دونوں پر موجود کنیکٹر پنوں کا معائنہ کریں۔",
              "question": "کیا آپ کو کنیکٹر پر ہرا زنگ، مڑی ہوئی پنیں، یا کچرا نظر آ رہا ہے؟"
            }
          },
          "is_terminal": true,
          "branches": [],
          "concludes": {
            "cause_id": "cause-bms-comm-timeout",
            "description": "BMS chip communication timeout due to corroded connector pins",
            "safety_class": "caution",
            "translations": {
              "ur": {
                "description": "زنگ آلود کنیکٹر پنوں کی وجہ سے BMS چِپ کمیونیکیشن ٹائم آؤٹ"
              }
            },
            "fixes": [
              {
                "fix_id": "fix-clean-battery-connector-pins",
                "description": "Clean battery connector pins with contact cleaner and reseat",
                "difficulty": "easy",
                "requires_technician": false,
                "est_minutes": 15,
                "warranty_status": null,
                "rank": 1,
                "translations": {
                  "ur": {
                    "description": "بیٹری کنیکٹر پنوں کو کانٹیکٹ کلینر سے صاف کریں اور دوبارہ لگائیں"
                  }
                }
              },
              {
                "fix_id": "fix-replace-bms-board",
                "description": "Replace BMS board (dealer-only repair)",
                "difficulty": "hard",
                "requires_technician": true,
                "est_minutes": 90,
                "warranty_status": null,
                "rank": 2,
                "translations": {
                  "ur": {
                    "description": "BMS بورڈ تبدیل کریں (صرف ڈیلر کے ذریعے مرمت)"
                  }
                }
              }
            ]
          }
        },
        {
          "step_id": "ds-power-1",
          "step_type": "question",
          "instruction": "Look at the battery indicator LEDs on the battery pack itself (not the display). Press the battery check button if your model has one.",
          "question": "Are the battery indicator LEDs completely off (no lights at all when you press the check button)?",
          "expected_response": "yes_no",
          "media_ref": null,
          "safety_class": null,
          "translations": {
            "ur": {
              "instruction": "خود بیٹری پیک پر موجود بیٹری انڈیکیٹر LEDs کو دیکھیں (ڈسپلے پر نہیں)۔ اگر آپ کے ماڈل میں بیٹری چیک بٹن ہے تو اسے دبائیں۔",
              "question": "کیا بیٹری انڈیکیٹر LEDs مکمل طور پر بند ہیں (چیک بٹن دبانے پر کوئی لائٹ نہیں جلتی)؟"
            }
          },
          "is_terminal": false,
          "branches": [
            {
              "condition": "*",
              "label": "Not sure / can't do this",
              "translations": null,
              "action": "escalate",
              "to_step_id": null
            },
            {
              "condition": "yes",
              "label": "LEDs are completely off",
              "translations": {
                "ur": {
                  "label": "LEDs مکمل طور پر بند ہیں"
                }
              },
              "action": "step",
              "to_step_id": "ds-power-2a"
            },
            {
              "condition": "no",
              "label": "LEDs show some activity",
              "translations": {
                "ur": {
                  "label": "LEDs کچھ سرگرمی دکھا رہی ہیں"
                }
              },
              "action": "step",
              "to_step_id": "ds-power-2b"
            }
          ],
          "concludes": null
        }
      ]
    },
